+// Bridges a 0-100 progress percentage out to the worker's outer JS scope.
+// Note: g_onProgress/outProgress() is called independently by several
+// distinct sub-phases of the repair (offset scanning, frame matching, mdat
+// rewrite, etc. -- see call sites in atom.cpp/mp4.cpp/rsv.cpp), each of
+// which restarts its own 0-100 sweep. It is therefore NOT one single
+// monotonically-increasing global counter across an entire repair; a UI
+// consuming this should treat each run of increasing values as "progress
+// within the current phase", not "progress through the whole job".
+static void wasm_report_progress(int pct) {
+	EM_ASM({ if (typeof self.onWasmProgress === 'function') self.onWasmProgress($0); }, pct);
+}
+
+// Plain-C exported entry point for the WASM build. `packed_args` is a
+// single string with one CLI argument per line (argv[0] is synthesized).
+// Avoids relying on emscripten's callMain()/_main handling, which does not
+// work for a two-argument main() under this emscripten version (see above).
+extern "C" int wasm_entry(const char* packed_args) {
+	g_onProgress = wasm_report_progress;
+
+	std::vector<std::string> parts;
+	std::string s(packed_args ? packed_args : "");
+	size_t start = 0;
+	while (true) {
+		size_t pos = s.find('\n', start);
+		std::string part = (pos == std::string::npos) ? s.substr(start) : s.substr(start, pos - start);
+		if (!part.empty()) parts.push_back(part);
+		if (pos == std::string::npos) break;
+		start = pos + 1;
+	}
+	std::vector<char*> argv_vec;
+	argv_vec.push_back((char*)"untrunc");
+	for (auto& p : parts) argv_vec.push_back(const_cast<char*>(p.c_str()));
+	return untrunc_wasm_real_main((int)argv_vec.size(), argv_vec.data());
+}
+#endif
